ing nombre\n    boolean es_principal\n    string categoria\n  }\n  PROFESOR {\n    bigint id PK\n    string nivel\n  }\n  MATERIA {\n    bigint id PK\n    bigint id_profesor FK\n    string nombre\n  }\n  CUIDADOR_MASCOTA {\n    bigint id PK\n  }\n  ANIMAL_ATENDIDO {\n    bigint id PK\n    bigint id_cuidador FK\n    string nombre\n  }\n  TECNICO {\n    bigint id PK\n  }\n  MARCA_EQUIPO {\n    bigint id PK\n    bigint id_tecnico FK\n    string nombre\n  }\n  HISTORIAL_CARTERA {\n    bigint id PK\n    bigint id_trabajador FK\n    bigint id_oficio_mas_solicitado FK\n    int trabajo_completado\n    double ganancia_mes\n  }\n  SERVICIO {\n    bigint id PK\n    bigint id_trabajador FK\n    string nombre\n    string descripcion\n    string oficio_asociado\n  }\n  SOLICITUD {\n    bigint id PK\n    bigint id_contratante FK\n    bigint id_trabajador FK\n    bigint id_servicio FK\n    string descripcion_solicitud\n    int cantidad_solicitud\n    string estado_solicitud\n    datetime creacion_solicitud\n  }\n  NOTIFICACION {\n    bigint id PK\n    bigint id_destinatario FK\n    bigint id_solicitud FK\n    string tipo\n    string mensaje\n    datetime fecha\n    boolean notificacion_leida\n  }\n  RESENA {\n    bigint id PK\n    bigint id_solicitud FK\n    bigint id_autor FK\n    bigint id_receptor FK\n    int calificacion\n    string comentario\n    datetime fecha\n    boolean reportada\n  }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="CFnqYF9P28QhxXad27UU-553">
